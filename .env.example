# ───────────────────────────────────────────────────────────────────────────────
# Copie para `.env` no desenvolvimento local. Em produção (EasyPanel) as
# variáveis são configuradas no painel — veja docs/DEPLOY-EASYPANEL.md.
#
# Prefixo VITE_  → lido no build e embutido no bundle do navegador.
# Sem o prefixo   → lido em runtime pelo servidor Node (SSR e server functions).
# Nunca coloque segredos em variáveis VITE_*: elas vão para o código público.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Domínio da aplicação ─────────────────────────────────────────────────────
# URL pública onde o app é servido, sem barra no final. Usada nos links de
# convite, na validação de CSRF atrás do proxy do EasyPanel e para decidir se o
# cookie de sessão pode ser `Secure`.
#
# APP_URL é lida em runtime: para trocar de domínio basta editar e reiniciar.
# Deixe em branco no desenvolvimento local para cair no window.location.origin.
APP_URL="https://financas.seudominio.com"

# VITE_APP_URL é opcional e normalmente deve ficar em branco. Por ser VITE_, o
# valor é gravado dentro do bundle no momento do build: se o domínio mudar
# depois, os links continuam apontando para o antigo até alguém rebuildar.
# No EasyPanel, `https://$(PRIMARY_DOMAIN)` resolve para o domínio do serviço.
VITE_APP_URL=""

# ─── Banco de dados (Postgres) ────────────────────────────────────────────────
# Conexão direta com o Postgres da aplicação. Só o servidor Node fala com o
# banco — o navegador nunca vê essas variáveis nem recebe uma conexão.
# O schema é criado/atualizado com `db/schema.sql` (veja db/README.md).
POSTGRES_HOST="186.226.112.41"
POSTGRES_PORT="5437"
POSTGRES_DB="app_financeiro_pg"
POSTGRES_USER="postgres"
# SEGREDO: nunca versione o valor real. Configure no painel do EasyPanel.
POSTGRES_PASSWORD=""
# `true` quando o banco exige TLS. Bancos em rede privada normalmente usam false.
POSTGRES_SSL="false"
# Schema onde ficam as tabelas. Precisa bater com o `app_schema` do db/schema.sql.
POSTGRES_SCHEMA="public"
# Opcional: conexões simultâneas por processo Node (padrão 10).
POSTGRES_POOL_MAX="10"

# ─── Cadastro de usuários ─────────────────────────────────────────────────────
# `true`  → a tela inicial mostra o formulário "Criar conta".
# `false` → o cadastro some da tela e o servidor recusa novos cadastros; entra-se
#           apenas por convite. Exceção: com o banco ainda vazio o primeiro
#           usuário sempre pode se cadastrar, senão ninguém conseguiria entrar.
CREATE_USERS_HOME="true"

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Opcionais. A sessão vive num cookie httpOnly e é validada contra a tabela
# `user_sessions`; revogar um login é apagar a linha correspondente.
SESSION_COOKIE_NAME="aura_session"
SESSION_TTL_DAYS="30"

# ─── IA (opcional) ────────────────────────────────────────────────────────────
# Provedor de IA da importação de faturas/extratos em /transacoes.
# Hoje só "openai" é aceito; qualquer outro valor faz o recurso falhar com uma
# mensagem clara em vez de tentar uma requisição que não funcionaria.
PROVEDOR_IA="openai"
# Modelo usado nas requisições, exatamente como o provedor o nomeia.
MODELO_IA="gpt-4o-mini"
# SEGREDO: chave da API do provedor. Sem ela o recurso fica indisponível e o
# resto do app segue funcionando normalmente.
OPENAI_API_KEY=""
# Teto de tokens do documento por requisição. Documento maior que isso é
# dividido em lotes, e o usuário processa um lote por vez na tela — assim o
# custo por requisição é previsível e nenhuma fatura é truncada em silêncio.
LIMITE_TOKENS="12000"
# Teto de lançamentos por requisição. É o limite que importa numa fatura grande:
# pedir uma centena de lançamentos de uma vez faz o modelo pular linhas, e ele
# não avisa quando pula. Vale o que estourar primeiro, este ou LIMITE_TOKENS.
# Baixe para 20-25 se ainda faltar lançamento; um valor bem alto (ex.: 1000)
# manda o documento inteiro numa requisição só. Em qualquer ajuste, o servidor
# continua conferindo a resposta contra o documento nos dois sentidos.
LIMITE_LANCAMENTOS_LOTE="40"

# ─── Logs da IA ───────────────────────────────────────────────────────────────
# Cada chamada ao provedor deixa no log do servidor o que foi enviado (prompt do
# sistema e texto do lote) e o que voltou (resposta crua, tokens e duração). É o
# que permite auditar uma importação que saiu errada. Aparece no log do
# container (no EasyPanel, na aba Logs do serviço).
LOG_IA="true"
# `false` mantém só os números (modelo, tokens, duração, nº de lançamentos) e
# deixa de registrar prompt e resposta.
LOG_IA_CORPO="true"
# Teto de caracteres de cada trecho registrado; o excedente vira "+N omitidos".
LOG_IA_LIMITE_CARACTERES="2000"

# ─── Chat com IA (opcional) ───────────────────────────────────────────────────
# O assistente do botão "Assistente", no cabeçalho do Finanças: a pessoa
# escreve "quanto gastei este mês em alimentação?" ou "gastei 158 no mercado" e
# o app consulta ou propõe o lançamento. É independente da importação de
# faturas acima — outro provedor, outra chave, outro modelo — porque são dois
# trabalhos diferentes: um lê documentos, o outro interpreta uma frase curta.
#
# Sem GROQ_API_KEY o botão simplesmente não aparece e o resto do app segue igual.
#
# A chave é gratuita e sai em https://console.groq.com/keys. A cota grátis é por
# minuto e por dia; ao estourar, o chat avisa e volta a funcionar sozinho.
#
# SEGREDO: nunca versione o valor real. Configure no painel do EasyPanel.
GROQ_API_KEY=""
# Modelo usado nas requisições, exatamente como a Groq o nomeia. Sem valor, o
# padrão é "llama-3.3-70b-versatile". Alternativas úteis na mesma cota grátis:
#   llama-3.1-8b-instant   → mais rápido e mais barato, erra mais na categoria
#   openai/gpt-oss-120b    → mais preciso em frases ambíguas
# A lista atual está em https://console.groq.com/docs/models.
MODELO_IA_CHAT="llama-3.3-70b-versatile"
# Endereço da API. A Groq fala o mesmo dialeto da OpenAI em /chat/completions,
# então este campo também aponta o chat para qualquer serviço compatível
# (incluindo um modelo local) sem tocar em código.
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Quantas mensagens anteriores acompanham cada pergunta. É o que faz "e em
# transporte?" ser entendido logo depois de uma pergunta sobre alimentação.
# Conversa longa não melhora a interpretação de uma frase curta, só encarece.
CHAT_IA_HISTORICO="6"
# Teto de tokens da resposta. A resposta é um JSON curto de intenção; isto é só
# uma trava para o caso de o modelo se perder.
CHAT_IA_MAX_TOKENS="800"
# Existe para o dia em que houver mais de um provedor de chat; hoje só "groq" é
# aceito, e qualquer outro valor falha na hora com mensagem clara.
PROVEDOR_IA_CHAT="groq"
#
# O log do chat obedece às mesmas variáveis LOG_IA* da seção acima: com
# LOG_IA=true, cada mensagem deixa no log o prompt enviado e o JSON devolvido.

# ─── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Usado na redefinição de senha (link enviado por e-mail) e na troca de e-mail
# da conta (código de confirmação enviado ao endereço novo). Sem SMTP_HOST o
# resto do app funciona normalmente; só esses dois fluxos ficam indisponíveis,
# com aviso na tela.
SMTP_HOST=""
# 587 com STARTTLS é o padrão da maioria dos provedores; 465 é TLS direto.
SMTP_PORT="587"
# Opcional: `true` para TLS direto na conexão. Sem valor, é `true` só na 465.
SMTP_SECURE=""
SMTP_USER=""
# SEGREDO: senha ou app password do provedor de e-mail.
SMTP_PASSWORD=""
# Endereço que aparece no campo De:. Sem valor, usa SMTP_USER.
SMTP_FROM=""
# Nome exibido junto do endereço.
SMTP_FROM_NAME="Aura Finanças"
# `false` aceita certificado autoassinado — útil em SMTP interno. Mantenha
# `true` com provedores públicos.
SMTP_TLS_REJECT_UNAUTHORIZED="true"

# ─── Anexos (S3 ou compatível) ────────────────────────────────────────────────
# Armazenamento dos arquivos anexados às tarefas. Funciona com a AWS S3 e com
# qualquer serviço compatível (MinIO, Cloudflare R2, Backblaze B2, Wasabi…);
# quem decide é o S3_ENDPOINT. Sem S3_BUCKET o app segue normal — só os anexos
# ficam indisponíveis, com a tela dizendo o que falta.
#
# O arquivo vai do navegador direto para o bucket, com URL assinada por este
# servidor; as credenciais nunca chegam ao navegador. Por isso o bucket precisa
# de CORS liberado para o domínio do app (PUT e GET) — veja
# docs/DEPLOY-EASYPANEL.md. Mantenha o bucket privado: a leitura também é por
# URL assinada, com prazo.
S3_BUCKET=""
# SEGREDO: chave de acesso do bucket.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Endpoint próprio. Deixe em branco para a AWS.
# Ex.: https://minio.seudominio.com  ou  https://<conta>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="us-east-1"
# Caminho em vez de subdomínio (host/bucket/chave). MinIO e a maioria dos
# compatíveis precisam de `true`; a AWS usa `false`. Em branco, segue o endpoint.
S3_FORCE_PATH_STYLE=""
# Teto por arquivo, em MB.
S3_MAX_UPLOAD_MB="50"
# Validade das URLs assinadas (envio e leitura), em segundos.
S3_URL_TTL_SEGUNDOS="900"

# ─── Google Agenda (opcional) ─────────────────────────────────────────────────
# Sincroniza as tarefas com a agenda de quem é responsável por elas. A conexão é
# por usuário: cada um autoriza o app na própria conta, pelo perfil. Sem
# GOOGLE_CLIENT_ID o app segue igual — só a agenda fica indisponível.
#
# Como obter, no Google Cloud Console (console.cloud.google.com):
#   1. Crie um projeto e ative a "Google Calendar API";
#   2. Tela de permissão OAuth: tipo Externo, escopo
#      .../auth/calendar.events (+ openid e email);
#   3. Credenciais → Criar → ID do cliente OAuth → Aplicativo da Web;
#   4. Em "URIs de redirecionamento autorizados", inclua exatamente:
#      https://financas.seudominio.com/api/google/callback
#      (o mesmo domínio de APP_URL, com /api/google/callback no fim).
GOOGLE_CLIENT_ID=""
# SEGREDO: segredo do cliente OAuth.
GOOGLE_CLIENT_SECRET=""
# Fuso dos compromissos criados na agenda.
GOOGLE_CALENDAR_TIMEZONE="America/Sao_Paulo"
# Minutos entre duas sincronizações automáticas do mesmo usuário. A leitura é
# incremental (só o que mudou), então dez minutos custa uma chamada por pessoa
# por rodada — bem dentro da cota gratuita da API do Calendar.
GOOGLE_SYNC_INTERVALO_MINUTOS="10"
# Teto de segurança de eventos lidos por sincronização. Não interrompe a
# paginação no meio: parar antes da última página custaria o marcador
# incremental, e sem ele toda rodada releria a agenda inteira.
GOOGLE_MAX_EVENTOS_SYNC="500"
# Log da sincronização: uma linha por evento que diz respeito a alguma tarefa,
# com a decisão tomada (readotado, datas atualizadas, já igual, descartado).
# É o que responde "por que a mudança feita no Google não voltou".
LOG_AGENDA="true"
# Também registra os eventos que não são espelho de tarefa nenhuma — a agenda
# pessoal inteira. Barulhento; ligue só para investigar.
LOG_AGENDA_TODOS="false"
# Opcional: chave que cifra os tokens do Google guardados no banco. Sem valor,
# deriva de GOOGLE_CLIENT_SECRET. Trocar aqui invalida as conexões existentes,
# que precisam ser refeitas.
GOOGLE_TOKEN_SECRET=""
# Opcional, mas recomendado: segredo que libera POST /api/google/sync, que roda
# uma rodada de sincronização e devolve o resumo em JSON. O agendador vive
# dentro do processo web e só sobe no primeiro acesso autenticado — um cron
# externo chamando esta rota garante a sincronização mesmo sem tráfego, e
# responde com números se ela está rodando. Sem valor, a rota fica fechada.
#   curl -X POST -H "authorization: Bearer $GOOGLE_SYNC_TOKEN" \
#        https://financas.seudominio.com/api/google/sync
GOOGLE_SYNC_TOKEN=""
# Só para testes: redireciona TODAS as chamadas ao Google para outro endereço.
# Deixe vazio em produção.
GOOGLE_API_BASE_URL=""

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta e interface do servidor Node em produção. O EasyPanel costuma injetar
# PORT sozinho; HOST precisa ser 0.0.0.0 para o proxy alcançar o container.
PORT="3000"
HOST="0.0.0.0"
