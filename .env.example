# ───────────────────────────────────────────────────────────────────────────────
# Copie para `.env` no desenvolvimento local. Em produção (EasyPanel) as
# variáveis são configuradas no painel — veja docs/DEPLOY-EASYPANEL.md.
#
# Prefixo VITE_  → lido no build e embutido no bundle do navegador.
# Sem o prefixo   → lido em runtime pelo servidor Node (SSR e server functions).
# Nunca coloque segredos em variáveis VITE_*: elas vão para o código público.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Domínio da aplicação ─────────────────────────────────────────────────────
# URL pública onde o app é servido, sem barra no final. Usada nos links de
# convite, na validação de CSRF atrás do proxy do EasyPanel e para decidir se o
# cookie de sessão pode ser `Secure`.
#
# APP_URL é lida em runtime: para trocar de domínio basta editar e reiniciar.
# Deixe em branco no desenvolvimento local para cair no window.location.origin.
APP_URL="https://financas.seudominio.com"

# VITE_APP_URL é opcional e normalmente deve ficar em branco. Por ser VITE_, o
# valor é gravado dentro do bundle no momento do build: se o domínio mudar
# depois, os links continuam apontando para o antigo até alguém rebuildar.
# No EasyPanel, `https://$(PRIMARY_DOMAIN)` resolve para o domínio do serviço.
VITE_APP_URL=""

# ─── Banco de dados (Postgres) ────────────────────────────────────────────────
# Conexão direta com o Postgres da aplicação. Só o servidor Node fala com o
# banco — o navegador nunca vê essas variáveis nem recebe uma conexão.
# O schema é criado/atualizado com `db/schema.sql` (veja db/README.md).
POSTGRES_HOST="186.226.112.41"
POSTGRES_PORT="5437"
POSTGRES_DB="app_financeiro_pg"
POSTGRES_USER="postgres"
# SEGREDO: nunca versione o valor real. Configure no painel do EasyPanel.
POSTGRES_PASSWORD=""
# `true` quando o banco exige TLS. Bancos em rede privada normalmente usam false.
POSTGRES_SSL="false"
# Schema onde ficam as tabelas. Precisa bater com o `app_schema` do db/schema.sql.
POSTGRES_SCHEMA="public"
# Opcional: conexões simultâneas por processo Node (padrão 10).
POSTGRES_POOL_MAX="10"

# ─── Cadastro de usuários ─────────────────────────────────────────────────────
# `true`  → a tela inicial mostra o formulário "Criar conta".
# `false` → o cadastro some da tela e o servidor recusa novos cadastros; entra-se
#           apenas por convite. Exceção: com o banco ainda vazio o primeiro
#           usuário sempre pode se cadastrar, senão ninguém conseguiria entrar.
CREATE_USERS_HOME="true"

# ─── Sessão ───────────────────────────────────────────────────────────────────
# Opcionais. A sessão vive num cookie httpOnly e é validada contra a tabela
# `user_sessions`; revogar um login é apagar a linha correspondente.
SESSION_COOKIE_NAME="aura_session"
SESSION_TTL_DAYS="30"

# ─── IA (opcional) ────────────────────────────────────────────────────────────
# Habilita a importação de faturas/extratos por IA em /transacoes.
# Sem ela o recurso responde "IA indisponível no momento" e o resto do app segue
# funcionando normalmente.
LOVABLE_API_KEY=""

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta e interface do servidor Node em produção. O EasyPanel costuma injetar
# PORT sozinho; HOST precisa ser 0.0.0.0 para o proxy alcançar o container.
PORT="3000"
HOST="0.0.0.0"
