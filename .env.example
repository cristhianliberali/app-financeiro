# ───────────────────────────────────────────────────────────────────────────────
# Copie para `.env` no desenvolvimento local. Em produção (EasyPanel) as
# variáveis são configuradas no painel — veja docs/DEPLOY-EASYPANEL.md.
#
# Prefixo VITE_  → lido no build e embutido no bundle do navegador.
# Sem o prefixo   → lido em runtime pelo servidor Node (SSR e server functions).
# Nunca coloque segredos em variáveis VITE_*: elas vão para o código público.
# ───────────────────────────────────────────────────────────────────────────────

# ─── Domínio da aplicação ─────────────────────────────────────────────────────
# URL pública onde o app é servido, sem barra no final.
# Usada nos e-mails de confirmação do Supabase, no retorno do login com Google,
# nos links de convite e na validação de CSRF atrás do proxy do EasyPanel.
#
# APP_URL é lida em runtime: para trocar de domínio basta editar e reiniciar.
# Deixe em branco no desenvolvimento local para cair no window.location.origin.
APP_URL="https://financas.seudominio.com"

# VITE_APP_URL é opcional e normalmente deve ficar em branco. Por ser VITE_, o
# valor é gravado dentro do bundle no momento do build: se o domínio mudar
# depois, os redirects continuam apontando para o antigo até alguém rebuildar.
# Em branco, o navegador usa o domínio real de onde a página foi aberta.
# Preencha só se o domínio canônico for diferente do domínio acessado.
VITE_APP_URL=""

# ─── Supabase (público) ───────────────────────────────────────────────────────
# A publishable key é segura para o navegador: o acesso aos dados é controlado
# pelas policies de RLS do banco.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_PROJECT_ID="seu-projeto"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PROJECT_ID="seu-projeto"

# ─── Supabase (secreto) ───────────────────────────────────────────────────────
# Ignora RLS. Só existe no servidor e nunca deve ter o prefixo VITE_.
# Opcional: só é necessária se alguma server function usar o client admin.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── IA (opcional) ────────────────────────────────────────────────────────────
# Habilita a importação de faturas/extratos por IA em /transacoes.
# Sem ela o recurso responde "IA indisponível no momento" e o resto do app segue
# funcionando normalmente.
LOVABLE_API_KEY=""

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta e interface do servidor Node em produção. O EasyPanel costuma injetar
# PORT sozinho; HOST precisa ser 0.0.0.0 para o proxy alcançar o container.
PORT="3000"
HOST="0.0.0.0"
